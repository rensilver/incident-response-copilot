# Server-only origin. Default for a host-run FastAPI backend:
INCIDENT_COPILOT_BACKEND_ORIGIN=http://127.0.0.1:8000
# On the Compose network, build with http://app:8000 instead.
# Production rewrites are fixed at build time; rebuild when this value changes.
