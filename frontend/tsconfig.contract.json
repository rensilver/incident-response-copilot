{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": ".contract-build",
    "rootDir": ".",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/lib/api/**/*.ts",
    "tests/api-contract.test.ts",
    "tests/api-transport.test.ts",
    "tests/api-types.ts"
  ],
  "exclude": ["node_modules", ".next", ".contract-build"]
}
