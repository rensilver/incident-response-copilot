                </p>
              </div>
              <div>
                <label
                  for="incident-minutes"
                >
                  Window (minutes)
                </label>
                <input
                  aria-describedby="minutes-hint minutes-error"
                  aria-invalid="false"
                  id="incident-minutes"
                  inputmode="numeric"
                  max="1440"
                  min="1"
                  name="minutes_back"
                  step="1"
                  type="number"
                  value="180"
                />
                <p
                  id="minutes-hint"
                >
                  1–1440 minutes
                </p>
              </div>
            </div>
            <button
              class="primary-action"
              type="submit"
            >
              Run investigation
            </button>
          </fieldset>
          <noscript>
            Enable JavaScript to submit investigations and check dependencies.
          </noscript>
        </form>
        <section
          aria-label="Investigation result"
          class="result-area"
        >
          <p
            role="status"
          >
            Investigation unavailable. Review the question and try again.
          </p>
        </section>
      </div>
    </main>
  </div>
