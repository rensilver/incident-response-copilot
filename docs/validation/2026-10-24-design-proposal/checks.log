review = root / 'docs/validation/2026-10-24-design-proposal/README.md'
log = root / 'docs/validation/2026-10-24-design-proposal/checks.log'
text = proposal.read_text()
expected = {str(p.relative_to(root)) for p in (proposal, review, log)}
staged = set(subprocess.check_output(['git', 'diff', '--cached', '--name-only'], text=True).splitlines())
assert staged == expected, (staged, expected)
subprocess.run(['git', 'diff', '--cached', '--check'], check=True)
assert not subprocess.check_output(['git', 'diff', '--name-only'], text=True).strip()
