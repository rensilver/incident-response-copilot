links = 0
for doc in (proposal, review):
    for target in re.findall(r'\[[^\]]+\]\(([^)]+)\)', doc.read_text()):
        if target.startswith(('https://', 'http://', '#')):
            continue
        assert (doc.parent / target.split('#')[0]).resolve().is_file(), (doc, target)
        links += 1
print(f'PASS: {links} local Markdown references resolve')

scenario_path = Path('backend/src/incident_copilot/demo/scenarios.py')
scenario = ast.parse(scenario_path.read_text())
messages = []
for node in ast.walk(scenario):
    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == 'LogTemplate':
        messages.extend(ast.literal_eval(k.value) for k in node.keywords if k.arg == 'message')
assert len(messages) == 7
assert all(f'`{message}`' in text for message in messages)
print('PASS: all seven quoted synthetic log messages match scenario definitions verbatim')
client_path = Path('streamlit_app/app.py')
client = ast.parse(client_path.read_text())
presets = next(ast.literal_eval(n.value) for n in client.body if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'EXAMPLES' for t in n.targets))
assert len(presets) == 3
for name, query, service, minutes in presets:
    assert f'| {name} | {query} | {service} |' in text
    assert minutes == 180
assert 'all use 180 minutes' in text
print('PASS: three preset names, questions, services, and 180-minute windows match existing client')

colors = dict(re.findall(r'\| (Paper|Canvas|Ink|Action|Caution|Error) \| `#([0-9A-F]{6})`', text))
assert len(colors) == 6
def luminance(value):
    channels = [int(value[i:i+2], 16) / 255 for i in (0, 2, 4)]
    linear = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in channels]
    return sum(c * w for c, w in zip(linear, (0.2126, 0.7152, 0.0722)))
for foreground in ('Ink', 'Action', 'Caution', 'Error'):
    for background in ('Paper', 'Canvas'):
        values = sorted((luminance(colors[foreground]), luminance(colors[background])))
        ratio = (values[1] + 0.05) / (values[0] + 0.05)
        assert ratio >= 4.5, (foreground, background, ratio)
        print(f'PASS: {foreground} on {background}: {ratio:.2f}:1 (>=4.5:1 text; >=3:1 controls/focus)')
print('Contrast calculation: sRGB linearization, luminance weights .2126/.7152/.0722; (Llighter+.05)/(Ldarker+.05); inverse filled-control pairs have the same ratio')

for required in ('IBM Plex Sans', 'IBM Plex Mono', 'Spacing tokens', 'Desktop, 1280', 'Tablet, 768', 'Mobile, 390', '320 px', '200%/400%', 'Critique against the brief', 'not a calibrated probability', 'neutral ordinals', '300-second browser budget', 'source\nand detail only'):
    assert required.lower() in text.lower(), required
for field in ('summary', 'confidence', 'likely_causes', 'title', 'rationale', 'supporting_evidence', 'next_steps'):
    if field == 'likely_causes':
        assert '**Possible causes**' in text
    else:
        assert field in text
print('PASS: palette/type/spacing/status, three wireframes, report hierarchy, critique, and API constraints present (manual reading also required)')

unchanged = 0
for name in subprocess.check_output(['git', 'ls-tree', '-r', '--name-only', 'HEAD'], text=True).splitlines():
    if not name.startswith('docs/') and name != 'README.md':
        baseline = subprocess.check_output(['git', 'show', f'HEAD:{name}'])
        assert Path(name).read_bytes() == baseline, name
        unchanged += 1
print(f'PASS: all {unchanged} existing non-documentation files match HEAD byte-for-byte')
private = subprocess.check_output(['git', 'check-ignore', '.env', 'REFACTORING_PLAN.md'], text=True).splitlines()
assert private == ['.env', 'REFACTORING_PLAN.md']
diff = subprocess.check_output(['git', 'diff', '--cached'], text=True)
assert not re.search(r'sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----', diff)
print('PASS: staged credential-pattern scan; .env and local plan stay ignored (no private content read)')

