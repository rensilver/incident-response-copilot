        exchange.outputs = [
            text_output(json.dumps(REPORT) if with_text else '{"summary":'),
            text_output(json.dumps(REPORT)),
        ]
        exchange.response_fields = [{"status": "incomplete", "incomplete_details": {"reason": reason}}]

