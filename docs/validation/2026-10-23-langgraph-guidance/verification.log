import json
import re
import subprocess
from pathlib import Path

base = '415ae62e5b3bd925da8b3559548475a1f2e096a4'
directory = Path('docs/validation/2026-10-23-langgraph-guidance')
expected = {str(directory / name) for name in ('README.md', 'attempts.md', 'inspect_installed.py', 'installed.json', 'verification.log')}
changed = set(subprocess.check_output(['git', 'diff', '--name-only', base], text=True).splitlines())
untracked = set(subprocess.check_output(['git', 'ls-files', '--others', '--exclude-standard'], text=True).splitlines())
assert changed | untracked == expected, (changed, untracked)
references = 0
for path in directory.glob('*.md'):
    for target in re.findall(r'\]\(([^)]+)\)', path.read_text()):
        if not target.startswith(('https://', 'http://', '#')):
            assert (path.parent / target.split('#')[0]).exists(), (path, target)
            references += 1
for private in ('.env', 'REFACTORING_PLAN.md'):
    subprocess.run(['git', 'check-ignore', '-q', private], check=True)
    assert not subprocess.check_output(['git', 'ls-files', '--', private], text=True)
for path in directory.iterdir():
    if path.is_file():
        content = path.read_text()
        assert not re.search(r'sk-[A-Za-z0-9_-]{16,}|lsv2_[A-Za-z0-9_-]{16,}|AKIA[A-Z0-9]{16}|-----BEGIN .*PRIVATE KEY-----', content), path
        assert all(line == line.rstrip() for line in content.splitlines()), path
record = json.loads((directory / 'installed.json').read_text())
assert len(record['packages']) == 7 and len(record['apis']) == 14
assert len(record['checks']) == 5 and all(record['checks'].values())
print(f'PASS: exactly five scoped evidence files; {references} local Markdown references; private file ignores; credential-pattern and whitespace checks; seven packages, fourteen APIs, five successful compatibility checks.')
print('No pre-existing tracked file changed; application behavior was not exercised.')
