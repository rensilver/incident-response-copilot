{
  "openapi": "3.1.0",
  "info": {
    "title": "incident-response-copilot",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/investigations": {
      "post": {
        "summary": "Create Investigation",
        "description": "Run an investigation and return the structured report.",
        "operationId": "create_investigation_api_v1_investigations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvestigationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Report liveness and downstream reachability.\n\nProbes run concurrently: each carries its own timeout, so awaiting them one\nafter another would let ``/health`` outlast the timeout of whatever polls it.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EvidenceRef": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/EvidenceSource"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "source",
          "detail"
        ],
        "title": "EvidenceRef",
        "description": "A pointer to the observation that supports a claim."
      },
      "EvidenceSource": {
        "type": "string",
        "enum": [
          "metrics",
          "logs"
        ],
        "title": "EvidenceSource",
        "description": "Which subsystem a piece of evidence came from."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "dependencies": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Dependencies"
          }
        },
        "type": "object",
        "required": [
          "status",
          "dependencies"
        ],
        "title": "HealthResponse",
        "description": "Liveness plus reachability of each downstream dependency."
      },
      "IncidentReport": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "likely_causes": {
            "items": {
              "$ref": "#/components/schemas/LikelyCause"
            },
            "type": "array",
            "title": "Likely Causes"
          },
          "next_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Next Steps"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "investigation_window": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimeWindow"
              },
              {
                "type": "null"
              }
            ],
            "description": "Authoritative query interval, populated by the service after generation"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "likely_causes",
          "next_steps",
          "confidence"
        ],
        "title": "IncidentReport",
        "description": "The structured output of an investigation."
      },
      "InvestigationRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "The incident question"
          },
          "service": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service",
            "description": "Service to focus on"
          },
          "minutes_back": {
            "type": "integer",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Minutes Back",
            "description": "Window length",
            "default": 60
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "InvestigationRequest",
        "description": "What an engineer asks the copilot to look into."
      },
      "LikelyCause": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "supporting_evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceRef"
            },
            "type": "array",
            "title": "Supporting Evidence"
          }
        },
        "type": "object",
        "required": [
          "title",
          "rationale",
          "confidence",
          "supporting_evidence"
        ],
        "title": "LikelyCause",
        "description": "One candidate root cause."
      },
      "TimeWindow": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "TimeWindow",
        "description": "A closed time interval to investigate."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
