# ---- OpenAI Responses ----
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=none
# Required backend credential; never put it in frontend configuration.
OPENAI_API_KEY=
# This application accepts exactly this model; reasoning effort is fixed to none.
OPENAI_MODEL=gpt-6-luna
# One deadline per text/tool operation or entire structured generation + repairs.
LLM_OPERATION_TIMEOUT_SECONDS=60
# Per-request output cap; transport failures are never retried.
LLM_MAX_OUTPUT_TOKENS=4096
# Includes the initial request; callers may lower but cannot raise this ceiling.
LLM_MAX_STRUCTURED_ATTEMPTS=3

PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_LOG_INDEX=app-logs

APP_ENV=dev
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-copilot

MAX_TOOL_ROUNDS=2
MAX_SUPERVISOR_ITERATIONS=3
