# ---- LLM provider selection ----
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=ollama
# Set LLM_FALLBACK_PROVIDER=none to use Groq only.

# ---- Groq ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_CTX=4096
# Available RAM required before loading a local model (MiB). Loaded model: 1024 MiB.
# Set to 0 only for a remote Ollama server; client RAM cannot measure that server.
OLLAMA_MIN_AVAILABLE_MEMORY_MB=4096

PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_LOG_INDEX=app-logs

APP_ENV=dev
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-copilot

MAX_TOOL_ROUNDS=2
MAX_SUPERVISOR_ITERATIONS=3
