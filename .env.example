# ---- OpenAI Responses ----
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=none
# Required backend credential; never put it in frontend configuration.
OPENAI_API_KEY=
# This application accepts exactly this model; reasoning effort is fixed to none.
OPENAI_MODEL=gpt-6-luna

PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_LOG_INDEX=app-logs

APP_ENV=dev
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-copilot

MAX_TOOL_ROUNDS=2
MAX_SUPERVISOR_ITERATIONS=3
